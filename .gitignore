# ── Secrets - NEVER commit these ──
.env
.env.*
!.env.example
secrets.toml
!secrets.toml.example
*.pem
*.key

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtual environments ──
venv/
.venv/
env/
ENV/

# ── Logs / runtime data ──
*.log
logs/
backend/logs/

# ── Datasets, models, weights ──
*.csv
*.safetensors
*.pkl
*.pt
*.bin
ml model/
saved_summary_model/

# ── Jupyter ──
.ipynb_checkpoints/

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
.vscode/

