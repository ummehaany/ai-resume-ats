# Copy to `.env` (never commit the real file). Placeholders only.
# In production set these as environment variables / secrets on your hosting platform instead.

# ── Backend (FastAPI) - REQUIRED ─────────────────────────────────────────────
# Groq API key: https://console.groq.com  ->  API Keys
GROQ_API_KEY=
# Supabase: Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ── Backend - optional ───────────────────────────────────────────────────────
# Only needed if your Supabase project still uses the legacy HS256 "JWT secret"
# (Project Settings -> API -> JWT Settings). New projects use signing keys and don't need this.
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret
# Comma-separated browser origins allowed to call the API (no trailing slash). The bundled Streamlit
# frontend calls the API from its server, so this only matters for browser-based clients.
# ALLOWED_ORIGINS=https://your-frontend.example.com
# GROQ_MODEL=openai/gpt-oss-120b
# SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
# ENABLE_DOCS=false                 # hide /docs and /redoc in production
# LOG_LEVEL=INFO
# LOG_FILE=                         # empty = console only (recommended for containers)
# Abuse protection (in-memory, per server process)
# ANALYZE_RATE_LIMIT_PER_MINUTE=5
# ANALYZE_RATE_LIMIT_PER_DAY=30
# GLOBAL_ANALYSES_PER_DAY=500
# MAX_CONCURRENT_ANALYSES=2

# ── Frontend (Streamlit) ─────────────────────────────────────────────────────
# Same Supabase project as above (anon key only - never the service_role key).
# The frontend reads SUPABASE_URL and SUPABASE_ANON_KEY from this file or from .streamlit/secrets.toml.
# URL of the running backend (no trailing slash). Default: http://localhost:8000
# BACKEND_URL=https://your-backend.example.com
# Where Supabase should send users back after Google sign-in = the URL of the Streamlit app.
# AUTH_REDIRECT_URL=https://your-app.streamlit.app
