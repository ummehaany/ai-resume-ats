# Copy to `frontend/.streamlit/secrets.toml` (git-ignored) for local use, or paste the same
# content into "Secrets" in Streamlit Community Cloud. Placeholders only.

[supabase]
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-anon-public-key"

[backend]
# URL of the deployed FastAPI backend, no trailing slash.
url = "http://localhost:8000"

[google_oauth]
# Must equal the URL of this Streamlit app AND be listed under
# Supabase -> Authentication -> URL Configuration -> Redirect URLs.
redirect_uri = "http://localhost:8501"
